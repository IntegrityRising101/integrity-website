---
import Layout from '../layouts/Layout.astro';
---
<Layout title="The Integrity Movement | Advancing Ethics & Governance">
  <section style="text-align: center; padding: 3rem 0;">
    <h1 style="font-size: 2.5rem; margin-bottom: 1rem;">Advancing Integrity, Transparency, and Ethical Leadership</h1>
    <p style="font-size: 1.2rem; color: #cbd5e1; max-width: 700px; margin: 0 auto 2rem auto;">
      Empowering communities with civic tools for governance and accountability, alongside personal transformation with Integrity Rising.
    </p>
    <div style="display: flex; gap: 1rem; justify-content: center;">
      <a href="/admin" style="background: #2563eb; color: white; padding: 0.75rem 1.5rem; border-radius: 6px; text-decoration: none; font-weight: 600;">Access Content Manager</a>
    </div>
  </section>
</Layout>
